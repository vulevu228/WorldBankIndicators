# --- Power BI temp / recovery files (keep the .pbip itself) ---
*.pbix.tmp
~$*

# --- Power BI Project (.pbip) local cache & per-user settings ---
# cache.abf is a regenerable compiled data cache; localSettings.json/editorSettings.json
# hold per-machine window/auth state. None of these belong in source control.
**/.pbi/cache.abf
**/.pbi/localSettings.json
**/.pbi/editorSettings.json
