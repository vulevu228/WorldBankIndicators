	measure 'Measles Immunization Trend' = IF(MIN('Health Indicators'[Year]) >= 1990, [Measles Immunization Median])
		formatString: 0"%"
		displayFolder: Chart measures
		lineageTag: 3b94aa27-ca3e-5dd6-a5af-b97b900076e9

	measure 'Chart Life Expectancy Start Value' = [Life Expectancy Start Value]
		formatString: 0.0
		displayFolder: Chart measures
		lineageTag: 6bb6db93-ccd4-5d68-ba32-e61c53f07054

	measure 'Chart Life Expectancy Latest Value' = [Life Expectancy Latest Value]
		formatString: 0.0
		displayFolder: Chart measures
		lineageTag: 05269c4d-2afa-5b45-8f43-10520ef0c80f

	measure 'Under Five Mortality Top 10 Countries' =
			VAR V = [Under Five Mortality Latest Value]
			RETURN IF(NOT ISBLANK(V) && RANKX(ALLSELECTED(Countries[Country]), [Under Five Mortality Latest Value], , DESC, Dense) <= 10, V)
		formatString: 0.0
		displayFolder: Rankings
		lineageTag: 4c0191a3-68cf-54ff-8b51-789abd4367c2

	measure 'Life Expectancy Gain Top 10 Countries' =
			VAR V = [Life Expectancy Change]
			RETURN IF(NOT ISBLANK(V) && RANKX(ALLSELECTED(Countries[Country]), [Life Expectancy Change], , DESC, Dense) <= 10, V)
		formatString: +0.0;-0.0;0.0
		displayFolder: Rankings
		lineageTag: f708020c-0b99-5340-a0a8-cc3a345ddd05

	measure 'Selected Country Label' = IF(HASONEVALUE(Countries[Country]), VALUES(Countries[Country]), COUNTROWS(VALUES(Countries[Country])) & " countries selected")
		displayFolder: Labels
		lineageTag: 74f355dd-aae5-5657-964f-ba0c4ea4cf68

	column Value
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7cca2f03-1576-5c58-b1da-d1e41a4c8aff
		summarizeBy: none
		sourceColumn: Value

		annotation SummarizationSetBy = Automatic

	partition _Measures = m
		mode: import
		source =
				let
				  Source = #table({"Value"}, {{0}}),
				  #"Changed Type" = Table.TransformColumnTypes(Source, {{"Value", Int64.Type}})
				in
				  #"Changed Type"

	annotation PBI_ResultType = Table

