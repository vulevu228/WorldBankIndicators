table _Measures
	lineageTag: 912a630c-c44f-5627-868b-9d4189dee706

	measure 'Life Expectancy Median' = CALCULATE(MEDIAN('Health Indicators'[Value]), 'Health Indicators'[Indicator Code] = "SP.DYN.LE00.IN")
		formatString: 0.0" yrs"
		displayFolder: Life Expectancy\1 Base
		lineageTag: 4cb2816b-ccfc-5186-8742-1bf1ce4e1ac8

	measure 'Life Expectancy End Year' = MIN(MAX('Health Indicators'[Year]), 2024)
		formatString: 0
		displayFolder: Life Expectancy\2 Reference years
		lineageTag: feec1688-b490-57c6-9c92-51ae0e1ddaaa

	measure 'Life Expectancy Start Year' = MAX(MIN('Health Indicators'[Year]), 1960)
		formatString: 0
		displayFolder: Life Expectancy\2 Reference years
		lineageTag: ebb860e6-dafa-5c4e-b1c6-b7b161d22bde

	measure 'Life Expectancy Latest Value' =
			VAR Y = [Life Expectancy End Year]
			RETURN CALCULATE([Life Expectancy Median], 'Health Indicators'[Year] = Y)
		formatString: 0.0" yrs"
		displayFolder: Life Expectancy\3 Latest vs start
		lineageTag: 1f843657-4811-5685-8551-4417cf71f399

	measure 'Life Expectancy Start Value' =
			VAR Y = [Life Expectancy Start Year]
			RETURN CALCULATE([Life Expectancy Median], 'Health Indicators'[Year] = Y)
		formatString: 0.0" yrs"
		displayFolder: Life Expectancy\3 Latest vs start
		lineageTag: a91af501-ac90-5c88-9561-f1290d2e00f4

	measure 'Life Expectancy Change' = IF(ISBLANK([Life Expectancy Latest Value]) || ISBLANK([Life Expectancy Start Value]), BLANK(), [Life Expectancy Latest Value] - [Life Expectancy Start Value])
		formatString: +0.0;-0.0;0.0
		displayFolder: Life Expectancy\3 Latest vs start
		lineageTag: 9427c067-af3d-5564-be0d-259b729e951e

	measure 'Life Expectancy All Countries Median' = CALCULATE([Life Expectancy Median], ALL(Countries))
		formatString: 0.0" yrs"
		displayFolder: Life Expectancy\4 Country profile
		lineageTag: deda23f6-3e27-519f-9e99-262fff4f2296

	measure 'Life Expectancy Change Summary' =
			VAR L = [Life Expectancy Latest Value]
			VAR B = [Life Expectancy Start Value]
			VAR D = L - B
			RETURN
			IF(ISBLANK(L) || ISBLANK(B), "no data in this range",
			    [Life Expectancy End Year] & "  |  " & IF(D >= 0, "▲ ", "▼ ") & FORMAT(ABS(D), "0.0") & " yrs" & " since " & [Life Expectancy Start Year])
		displayFolder: Life Expectancy\3 Latest vs start
		lineageTag: 2e698534-ef84-562b-8cf7-d0b7db0a0756

